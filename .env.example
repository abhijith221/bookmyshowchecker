# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=123456789

# Optional (defaults shown)
# MOVIE_NAME=Jailer 2
# MOVIE_REGEX=\bjailer\s*(2|ii)\b
# TARGET_DATES=20261015              # add 20261014 to also catch eve/premiere shows
# VENUES=ASLC,KSNT,PLTD,PKKT,CMTT   # first one = primary (gets the loud alert)
# POLL_SECONDS=60
# POLL_JITTER_SECONDS=30            # adds 0 to 30s random jitter per cycle (checks at 60-90s unpredictable intervals)
# REQUEST_GAP_MIN=3.0               # min seconds between venues in a cycle
# REQUEST_GAP_MAX=8.0               # max seconds between venues in a cycle
# EARLIEST_N=6
# PRIMARY_REPEAT=3                   # how many pings when Ariesplex opens
# FAIL_ALERT_AFTER=10                # warn on Telegram after N failed checks in a row...
# FAIL_ALERT_MINUTES=15              # ...or after this many minutes of failures, whichever first
# OTHER_VENUES_EVERY=3               # non-Ariesplex venues checked every Nth cycle (1 = every cycle)
# MAX_BACKOFF_SECONDS=900            # longest pause when BookMyShow rate-limits / blocks
# HEARTBEAT_HOUR_IST=9               # daily "still alive" message; -1 disables
# CITY_SLUG=trivandrum               # used for BookMyShow URLs
# CITY_CODE=triv                     # used for BookMyShow buytickets URLs
# OPEN_BROWSER=false                 # set to true to auto-launch BookMyShow tab in browser when open
